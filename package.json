{
  "name": "gaffer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "vitest run",
    "balance": "tsx packages/engine/harness/cli.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . && stylelint \"apps/web/**/*.css\" && tsx scripts/css-classes.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "match": "tsx apps/match-cli/src/main.ts",
    "log": "tsx scripts/log.ts",
    "pseudonymize": "tsx scripts/pseudonymize.ts",
    "fill-nationality": "tsx scripts/fill-nationality.ts",
    "fill-squad-roles": "tsx scripts/fill-squad-roles.ts",
    "e2e": "playwright test",
    "dev": "pnpm --filter @gaffer/web dev"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@gaffer/agents": "workspace:*",
    "@gaffer/engine": "workspace:*",
    "@gaffer/llm": "workspace:*",
    "@next/eslint-plugin-next": "^15.5.23",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.6",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
